@model BoardCardViewModel
@inject Clock Clock
@{
    var t = Model.Item;
}
<article class="card @Labels.StatusCss(t.Status)" draggable="true" data-task-id="@t.Id"
         style="--project:@t.Project.Color" title="@t.Project.Name">
    <div class="card-top">
        <span class="pc-chip">🖥 @(t.LastWorkerName ?? "Sin PC")</span>
        <span class="user-chip small" title="@t.CreatedByName">@Labels.Initials(t.CreatedByName)</span>
    </div>
    @if (t.Status != WorkStatus.Idle)
    {
        <div class="status-pill @Labels.StatusCss(t.Status)">@Labels.StatusIcon(t.Status) @Labels.Of(t.Status)</div>
    }
    @if (Model.ResolvingConflicts)
    {
        <div class="status-pill st-conflicts" title="El desarrollador integra @t.BaseBranch y resuelve los conflictos del pull request #@t.PullRequestNumber">🔧 Arreglando conflictos del PR</div>
    }
    else if (Model.ShowConflicts)
    {
        @* Fuera de .branches para que también se vea en la vista compacta. site.js no abre el detalle al pulsar el botón. *@
        <div class="conflict-row">
            <span class="status-pill st-conflicts" title="GitHub informa que el pull request #@t.PullRequestNumber no se puede integrar en @t.BaseBranch">⚠️ El PR tiene conflictos</span>
            @if (Model.CanResolveConflicts)
            {
                <button type="button" class="conflict-fix" draggable="false" data-resolve-conflicts="@t.Id"
                        title="Arreglar los conflictos: la tarea regresa al desarrollador, que integra @t.BaseBranch y resuelve los conflictos">🔧</button>
            }
        </div>
    }
    @if (Model.DevelopmentElapsed is { } elapsed)
    {
        <span class="dev-timer" title="Tiempo que lleva el desarrollador implementando la tarea"
              data-elapsed="@((long)elapsed.TotalSeconds)">⏱ <span data-timer-text>@Labels.Stopwatch(elapsed)</span></span>
    }
    <h3><span class="task-id">#@t.Id</span> @t.Title</h3>
    <p class="excerpt">@Labels.Excerpt(t.Description)</p>
    <div class="meta">
        <span class="prio @Labels.PriorityCss(t.Priority)">● @Labels.Of(t.Priority)</span>
        @if (!string.IsNullOrWhiteSpace(t.Labels))
        {
            foreach (var label in t.Labels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                <span class="label">@label</span>
            }
        }
    </div>
    <div class="branches">
        <code>⌥ @t.BaseBranch</code>
        @if (t.WorkBranch is not null) { <code>↳ @t.WorkBranch</code> }
    </div>
    @* Fuera de .branches para que también se vea en la vista compacta. site.js no abre el detalle al hacer clic en un enlace. *@
    @if (!string.IsNullOrWhiteSpace(t.PullRequestUrl))
    {
        <a href="@t.PullRequestUrl" target="_blank" rel="noopener noreferrer" class="pr-link" draggable="false"
           title="Abrir el pull request en GitHub (pestaña nueva)">🔗 Ver pull request #@t.PullRequestNumber</a>
    }
    @if (t.Status == WorkStatus.Failed && t.LastError is not null)
    {
        <p class="error-line">@Labels.Excerpt(t.LastError, 120)</p>
    }
    <footer>
        <span>Creada: @Clock.Format(t.CreatedAt)</span>
        @if (t.TotalTokens > 0)
        {
            <span>@Labels.Usd(t.TotalCostUsd) · @Labels.Tokens(t.TotalTokens) tokens</span>
        }
    </footer>
</article>
